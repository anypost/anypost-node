{
  "name": "anypost",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Anypost email API.",
  "license": "MIT",
  "homepage": "https://anypost.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/anypost/anypost-node.git"
  },
  "bugs": {
    "url": "https://github.com/anypost/anypost-node/issues"
  },
  "keywords": [
    "anypost",
    "email",
    "transactional-email",
    "smtp",
    "api"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
